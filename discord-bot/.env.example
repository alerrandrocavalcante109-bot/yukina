# Nunca coloque valores reais neste arquivo nem no Git.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# ID do cargo de equipe que pode aprovar/recusar. Obrigatório.
VIP_STAFF_ROLE_ID=
# Categoria para os tickets (opcional).
VIP_TICKET_CATEGORY_ID=
# Caminho do banco persistente. Em hospedagem, use disco persistente.
VIP_DATABASE_PATH=./data/yukina-vip.sqlite
# Limite de anexos aceitos por arquivo (bytes); máximo recomendado 5 MiB.
VIP_MAX_ATTACHMENT_BYTES=5242880
