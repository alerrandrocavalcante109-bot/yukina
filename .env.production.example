# Copie para .env e preencha apenas no servidor.
DISCORD_TOKEN=cole_o_token_do_bot_aqui
DISCORD_CLIENT_ID=1537936570869350400

# MyMemory Translation API — não exige API Key.
# MYMEMORY_EMAIL é opcional e aumenta a cota anônima de 5.000 para 50.000 caracteres/dia.
# MYMEMORY_EMAIL=contato@seudominio.com

# Endereços autorizados a chamar a API (separados por vírgula).
PANEL_ORIGINS=https://yukina-6uo.pages.dev
# Em produção, use disco persistente para os dados.
YUKINA_SETTINGS_FILE=data/guild-settings.json

# MongoDB Atlas para configurações do painel
MONGODB_URI=mongodb+srv://USUARIO:SENHA_URL_ENCODED@SEU_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=yukina
