# Copie este arquivo para .env e preencha localmente.
# Nunca publique tokens reais nem o Deploy Hook no GitHub.
DISCORD_TOKEN=seu_token_do_bot
CLIENT_ID=id_da_aplicacao

# Prefixo dos comandos por mensagem (não use PREFIX no Termux)
YUKINA_PREFIX=Y

# Opcional: ID do servidor para registrar comandos de teste rapidamente.
GUILD_ID=

# Monitoramento do repositório do Aeternus (serviço hospedado no Render).
# Aceita owner/repository ou a URL do GitHub.
AETERNUS_REPO=seu-usuario/seu-repositorio-aeternus
AETERNUS_BRANCH=main
# Cole aqui o Deploy Hook secreto do serviço Aeternus no Render.
AETERNUS_RENDER_DEPLOY_HOOK=
# Opcional; recomendado se o repositório do Aeternus for privado.
GITHUB_TOKEN=
