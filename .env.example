# Copie este arquivo para .env e preencha os valores reais.
# Nunca publique tokens, senhas ou a URI real do banco no GitHub.
DISCORD_TOKEN=cole_o_token_do_bot_aqui

# MongoDB Atlas — troque USUARIO e SENHA_URL_ENCODED pelos dados do Database User.
# Codifique caracteres especiais da senha para uso em uma URI (percent-encoding).
# No Atlas, confira também Network Access para o ambiente onde o bot será executado.
MONGODB_URI=mongodb+srv://USUARIO:SENHA_URL_ENCODED@yukina1.1vucjrz.mongodb.net/?retryWrites=true&w=majority&appName=Yukina
MONGODB_DB=yukina

# Microsoft Translator (Azure AI Translator) — credenciais do recurso Translator.
# AZURE_TRANSLATOR_REGION deve ser a região selecionada ao criar o recurso no Azure.
AZURE_TRANSLATOR_KEY=cole_a_chave_do_translator_aqui
AZURE_TRANSLATOR_REGION=regiao_do_recurso
# Opcional; normalmente mantenha o endpoint padrão usado pelo serviço.
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Configurações opcionais para serviços que forem implementados no backend.
# PANEL_API_URL=
# DISCORD_CLIENT_ID=1537936570869350400

# Compras Yukina VIP — configure estes valores também nas Environment Variables do Render.
VIP_PIX_KEY=cole_sua_chave_pix_aqui
VIP_ADMIN_ID=1533034328928555141
VIP_GUILD_ID=1533909454028935189
